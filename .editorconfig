root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Shell scripts must stay LF or bash fails on Windows checkouts.
[*.sh]
end_of_line = lf

# Exported data files are kept byte-for-byte as produced.
[*.{csv,txt}]
trim_trailing_whitespace = false
insert_final_newline = unset
end_of_line = unset
