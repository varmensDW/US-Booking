# US Booking Automation: local configuration template.
# Copy to .env and fill in locally. Never commit .env or paste its values into chat, logs or tickets.
# Check with: npm run check:env   (prints names and status only, never values)

NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3100

# OMS read-only connection: the ledsone mirror. Must be a SELECT-only role.
# The app never writes to the OMS; keep this separate from the booking URLs below.
OMS_READ_DATABASE_URL=

# Optional. Name of the OMS database; the sync stops if the OMS URL connects elsewhere.
# Defaults to ledsone.
# OMS_DATABASE_EXPECTED_NAME=ledsone

# Booking runtime connection, used by the app. Approved setup: varmen_user on varmen_db (the schema
# owner, see BOOKING_ROLE_MODE). With a separate runtime role it would be a DML-only login.
BOOKING_DATABASE_URL=

# Booking migration/owner connection: the role that owns schema us_booking (varmen_user).
# Used by npm run db:migrate. In single-role mode it is the same connection as above.
BOOKING_MIGRATION_DATABASE_URL=

# Expected booking database name (varmen_db). Migrations and preflight refuse to run if the
# connected database has a different name. Must match the database in both booking URLs above.
BOOKING_DATABASE_EXPECTED_NAME=

# single   = approved: one login owns the schema and runs the app (runtime-role restrictions do
#            not apply; see docs/setup.md).
# separate = a distinct DML-only runtime role (db/proposed/0002_us_booking_grants.sql).
BOOKING_ROLE_MODE=single

# Shippo test configuration. Use a Shippo TEST token while the integration is unverified.
SHIPPO_API_TOKEN=
SHIPPO_MODE=test

# Placeholder flag; no application code reads it yet. Keep false.
ENABLE_LIVE_BOOKING=false

# Local-development label storage only. Deployment storage is not configured yet.
LABEL_STORAGE_DIR=./storage/labels

# Wayfair SANDBOX integration (Dropship registration and shipping labels). Server-only; never shown
# in the browser or logs. The OMS stays the only source of orders: there is no Wayfair order import.
# Endpoints are fixed in src/server/wayfair/config.ts from Wayfair's official documentation; only the
# sandbox is supported and nothing falls back to production.
# sandbox = the only supported value in this phase.
WAYFAIR_MODE=sandbox
# Client ID and Client Secret of the SANDBOX application (Wayfair Developer Portal > Application
# Management). Used only to request a sandbox access token.
WAYFAIR_SANDBOX_CLIENT_ID=
WAYFAIR_SANDBOX_CLIENT_SECRET=
# Wayfair supplier id of our US supplier account (as returned in getDropshipPurchaseOrders.supplierId).
# Sandbox POs whose supplierId matches neither this nor WAYFAIR_WAREHOUSE_ID are refused.
WAYFAIR_SUPPLIER_ID=
# Optional. Wayfair's own warehouse id, sent as registrationInput.warehouseId. Leave empty to let
# Wayfair use the PO's assigned warehouse. It is NOT the OMS warehouse id (32 = US1 in the OMS).
WAYFAIR_WAREHOUSE_ID=
# Must stay false: direct Wayfair order ingestion is not implemented (orders come from the OMS).
WAYFAIR_ORDER_IMPORT_ENABLED=false
