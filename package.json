{
  "name": "us-booking-automation",
  "version": "0.1.0",
  "private": true,
  "description": "US1 booking and label printing (US/Canada): OMS sync, review dashboard",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:env": "node scripts/check-env.mjs",
    "db:preflight": "node scripts/db-preflight.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "sync:oms": "node scripts/oms-sync.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "flag-icons": "7.5.0",
    "lucide-react": "1.52.0",
    "motion": "13.5.1",
    "next": "16.4.2",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
